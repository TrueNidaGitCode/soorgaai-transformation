# ============================================================
# SoorgaAI Backend — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.
# ============================================================

# ── Server ───────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── MongoDB Atlas ─────────────────────────────────────────────
# Get from: MongoDB Atlas → Cluster → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/soorgaai?retryWrites=true&w=majority

# ── JWT Auth ──────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_CHAR_SECRET

# ── Anthropic (Claude) ────────────────────────────────────────
# Get from: https://console.anthropic.com/api-keys
# Used for: AI Maturity Report generation
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# ── Frontend URL (CORS) ───────────────────────────────────────
# Your Vercel deployment URL (update after Vercel deploy)
FRONTEND_URL=https://soorgaai-transformation.vercel.app

# ── Optional: OpenAI ──────────────────────────────────────────
# Only needed if you add OpenAI features later
# OPENAI_API_KEY=sk-proj-REPLACE_WITH_YOUR_KEY

# ── Optional: Email (nodemailer) ─────────────────────────────
# Used for: password reset emails
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASS=your-gmail-app-password
# EMAIL_FROM=noreply@soorgaai.com

# ── Token encryption (Confluence connector) ──────────────────
# Encrypts third-party OAuth tokens at rest (AES-256-GCM). Required to use
# the Confluence connected-knowledge feature.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# TOKEN_ENCRYPTION_KEY=REPLACE_WITH_32_BYTE_BASE64_KEY

# ── Confluence OAuth 2.0 (3LO) ────────────────────────────────
# Register an app at: https://developer.atlassian.com/console/myapps/
# CONFLUENCE_OAUTH_CLIENT_ID=REPLACE_WITH_CLIENT_ID
# CONFLUENCE_OAUTH_CLIENT_SECRET=REPLACE_WITH_CLIENT_SECRET
# CONFLUENCE_OAUTH_CALLBACK_URL=http://localhost:3000/api/confluence/callback
# Optional — caps pages processed per sync (default 200)
# CONFLUENCE_MAX_PAGES_PER_SYNC=200

# ── GitHub App: read-only repository access (Aria) ────────────
# Separate from the OAuth App Eame delivers through, and deliberately so.
# The OAuth App requests the classic `repo` scope, which is read AND write on
# every repository the user owns — GitHub offers no narrower classic scope.
# Asking a customer for that on a data-connection screen is not acceptable, so
# Aria uses a GitHub App with Contents: Read-only, which GitHub itself prevents
# from writing.
#
# Created ONCE by Svarg, not per customer. Customers then install it on their
# own account and choose which repositories it may read.
#
# Create at: https://github.com/settings/apps/new
#   Permissions: Repository → Contents: Read-only. Nothing else — the point of
#                this app is that it cannot do anything else.
#   Post installation → Setup URL:
#                http://localhost:3000/api/github/app/callback
#                (production: https://<your-railway-host>/api/github/app/callback)
#                GitHub returns installation_id, setup_action and the state we
#                sent, which is how the installation is tied to a Svarg user.
#   Webhook:     uncheck "Active" — nothing here listens for one.
#   Installable: "Any account", so customers can install it on theirs.
#
# GITHUB_APP_ID=REPLACE_WITH_NUMERIC_APP_ID
# GITHUB_APP_SLUG=replace-with-app-slug-from-its-public-url
# Private key: generate one on the App's settings page and paste the PEM with
# literal \n between lines, or as a real multi-line value.
# GITHUB_APP_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\nREPLACE\n-----END RSA PRIVATE KEY-----

# ── Which model the products run on ───────────────────────────
# Cob stays on the default chain: its prompts were tuned against it and every
# later stage is built on its output. Everything after Cob — Aria, Arth, Eame,
# Yusu — can run locally, which costs nothing while they are being built and
# keeps a customer's source code on the machine.
# Unset means "use the default chain", which is the behaviour before this
# existed. A configured provider that fails falls back rather than erroring.
# PRODUCT_LLM_PROVIDER=selfhosted

# Embedding customer code sends every selected file's full text to the
# embedding provider. Nothing retrieves code yet (that arrives with Eame), so
# chunks are stored WITHOUT vectors by default and can be backfilled later
# without going back to GitHub. Set to 1 when there is something to retrieve for.
# CODE_CHUNK_EMBEDDING=0

# ── The GitHub App must be PUBLIC ─────────────────────────────
# GitHub Apps are private when created: only the account that owns the app can
# authorize or install it. Every other account gets a bare 404 from the
# authorize and install pages, with nothing said about why.
#
# So a private app works perfectly for whoever built it and fails for every
# customer — the worst possible failure to discover late.
#
# The control is NOT called "make public" anywhere in the UI. It is:
#   github.com/settings/apps → <app> → near the bottom →
#   "Where can this GitHub App be installed?" → "Any account"
#
# ("Only on this account" is the default, and is what produces the 404.)
# Any account does not mean listed: Marketplace listing is a separate
# submission.

# ── Svarg-hosted tenant environments (the Arth "Prepare" step) ─────────────
#
# Only needed for "Svarg environment" hosting, where Svarg stands up a
# container, a database and a model gateway for the customer. The other
# option — "Your own environment" — needs none of this: Eame ships the
# deployment files and Svarg prepares nothing.
#
# Without RAILWAY_API_TOKEN the Prepare button returns 503 and names this
# variable. That is a missing configuration, not a failure.
#
# The token is a Railway account token from railway.com/account/tokens.
RAILWAY_API_TOKEN=

# Which workspace new tenant projects are created in. Optional: without it the
# code asks the token which workspaces it can see, which works for an account
# with exactly one. Set it explicitly if that lookup is ambiguous or fails.
RAILWAY_WORKSPACE_ID=

# Region for tenant projects. Defaults to us-west.
RAILWAY_REGION=us-west

# Project ids that destroy() must always refuse, comma separated. Put
# production here. The tenant-name prefix check is the first guard; this is the
# one that matters when a name is wrong.
RAILWAY_PROTECTED_PROJECT_IDS=

# The cluster tenant databases are created on. Falls back to MONGO_URI, which
# is fine for a single-cluster setup and wrong the moment tenants should be
# isolated from Svarg's own data.
TENANT_CLUSTER_URI=

# What a deployed tenant app calls back to for model access. Falls back to the
# request's own host, which is correct in production and wrong behind a proxy
# or when preparing from localhost.
GATEWAY_BASE_URL=

# ── Publishing built agents (Eame → Yusu) ─────────────────────────────────
#
# Every agent Eame builds is pushed to a repository on this account, and
# Railway builds from there. Deliberately the SAME GitHub account that hosts
# the application itself: Railway's GitHub App is installed and authorised
# once, so a repo created this morning is deployable this morning without
# anyone granting anything. Pointing it at a customer's account instead meant
# asking every customer to give their deploy platform read access to their own
# code — overhead that bought them nothing, since their copy of the code is
# the zip from /api/delivery/download.
#
# Without both variables the Deploy step on Yusu returns 503 and names them.
# That is a missing configuration, not a failure — but note it also leaves the
# customer with no delivered code at all, since the download button unlocks
# off a completed push.
#
# A plain account login or an organisation; both work. ownerIsOrg() asks
# GitHub which it is rather than trusting a flag here, because the answer
# picks the creation endpoint (/orgs/{org}/repos vs /user/repos).
SVARG_GITHUB_OWNER=

# A token belonging to that owner.
#
# IMPORTANT: on a plain account the repo is created via /user/repos, which
# creates it under whoever the TOKEN belongs to — SVARG_GITHUB_OWNER is not
# checked against it. A token minted on the wrong account therefore succeeds
# and puts every delivered agent in the wrong place, silently. Mint it on the
# account named above.
#
# Repositories are created on demand, one per blueprint, so the token must
# cover repos that do not exist yet:
#
#   classic PAT     scope `repo` — covers every current and future repo, and
#                   is the simpler choice for exactly that reason.
#   fine-grained    "All repositories" (NOT a selected list — a new repo would
#                   fall outside it), with Contents: Read and write plus
#                   Administration: Read and write so it can create them.
#
# A token that cannot see the owner surfaces as "Svarg's GitHub credentials
# were rejected" rather than a raw 401, since it is Svarg's configuration
# problem and not the caller's.
SVARG_GITHUB_TOKEN=

# ── Which model runs Svarg ────────────────────────────────────────────────
#
# One variable decides it. PROVIDER_CHAIN is a FAILOVER list, so a single
# entry means a failure surfaces as a failure; adding a second means a
# failure silently becomes the other provider's work, which is the wrong
# answer while comparing two of them.
#
#   PROVIDER_CHAIN=gemini                    everything on Gemini
#   PROVIDER_CHAIN=selfhosted                everything on an OpenAI-compatible
#                                            endpoint (Sarvam, Ollama, vLLM)
#
# Switching back is exactly this line and a restart. Nothing else holds a
# provider name: EAME_BUILD_PROVIDER and PRODUCT_LLM_PROVIDER are unset by
# default and mean "follow the chain".
PROVIDER_CHAIN=gemini

# Pin one stage to a different provider from the rest. Both unset = the chain.
#   EAME_BUILD_PROVIDER    only the model that writes applications
#   PRODUCT_LLM_PROVIDER   all post-Cob work (Aria, Arth, Eame), not Cob
# EAME_BUILD_PROVIDER=
# PRODUCT_LLM_PROVIDER=

# ── Sarvam AI ─────────────────────────────────────────────────────────────
# A named provider, keyed like any other paid one. Not "selfhosted": it is a
# hosted commercial API, and a deployment should be able to use it and a local
# model at the same time.
#
#   PROVIDER_CHAIN=sarvam
#   SARVAM_API_KEY=…
#   SARVAM_MODEL=sarvam-105b        (default; 128K context, reasoning, caching)
#
# sarvam-105b-conversations is dialogue-tuned and a poor fit for Eame, which
# needs a strict file-block format rather than conversation.
SARVAM_API_KEY=
SARVAM_MODEL=
# Only if Sarvam moves the endpoint. Defaults to https://api.sarvam.ai/v1
# SARVAM_BASE_URL=

# ── A self-hosted OpenAI-compatible server ────────────────────────────────
# Ollama, vLLM, TGI — anything speaking /chat/completions. The privacy path:
# nothing sent here leaves wherever that server runs.
#
# Check one before trusting it with a run:
#   node scripts/check_selfhosted_model.mjs <model-id>
SELFHOSTED_BASE_URL=
SELFHOSTED_API_KEY=
SELFHOSTED_MODEL=

# Extra output budget for a model that thinks before it answers, added to
# every request on top of what the caller asked for.
#
# A thinking model charges its reasoning against the same ceiling, so a
# budget sized for the visible answer returns an EMPTY string — no error,
# nothing to notice. Measured on sarvam-105b: 200 tokens produced nothing
# after two seconds of work, 400 produced an answer. The short calls in this
# codebase ask for 200-400.
#
# Applies to gemini, sarvam and selfhosted alike. Raise it for a model that
# reasons more; 0 disables it for one that does not think at all.
LLM_THINKING_HEADROOM=2048
