# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/your-application
JWT_SECRET=replace-with-a-long-random-string
APP_NAME=__APP_NAME__

# Let the front door mint a browser session (hosted deployments set this).
# Leave it unset to put your own sign-in in front.
# APP_PUBLIC_ACCESS=true

# ── Your data ────────────────────────────────────────────────────────────
# Unlocks the Data page, where your records are imported and sources are
# connected. On Svarg it was shown once at go-live; set your own here.
APP_OWNER_KEY=
# Keys the credentials of connected sources (Jira, Confluence, GitHub) in
# the database. 32 random bytes, base64:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Without it the key is derived from JWT_SECRET, which works but keeps the
# credentials and the key in one place.
CONNECTOR_ENCRYPTION_KEY=

# ── The model ────────────────────────────────────────────────────────────
# Set whichever keys you have — the application fails over through this
# list in order (gemini -> claude -> openai by default). Override the order
# with PROVIDER_CHAIN, e.g. PROVIDER_CHAIN=claude,openai
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# PROVIDER_CHAIN=gemini,claude,openai

# Or a self-hosted, Ollama-compatible endpoint (add 'selfhosted' to the chain).
# On Svarg this points at Svarg's gateway, which meters usage and stores nothing.
# SELFHOSTED_BASE_URL=http://localhost:11434/v1
# SELFHOSTED_API_KEY=
# SELFHOSTED_MODEL=llama3.1:8b

# ── Embeddings, if the application retrieves ─────────────────────────────
# Defaults to OpenAI's text-embedding-3-small, reusing OPENAI_API_KEY.
#   EMBEDDING_PROVIDER=selfhosted
#   SELFHOSTED_EMBEDDING_BASE_URL=http://localhost:11434/v1
#   SELFHOSTED_EMBEDDING_DIMENSIONS=768
# EMBEDDING_PROVIDER=openai
