# ── Server ───────────────────────────────────────────────────────────────
PORT=3000
MONGO_URI=mongodb+srv://user:password@cluster.mongodb.net/defect-matching
JWT_SECRET=replace-with-a-long-random-string

# ── LLM provider(s) ──────────────────────────────────────────────────────
# Set whichever keys you have — matchDefect() fails over through this list
# in order (gemini -> claude -> openai by default). Override the order with
# PROVIDER_CHAIN, e.g. PROVIDER_CHAIN=claude,openai
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# PROVIDER_CHAIN=gemini,claude,openai

# ── Embeddings ───────────────────────────────────────────────────────────
# Defaults to OpenAI's text-embedding-3-small (1536 dimensions), reusing
# OPENAI_API_KEY above. To point at a self-hosted embedding model instead:
#   EMBEDDING_PROVIDER=selfhosted
#   SELFHOSTED_EMBEDDING_BASE_URL=http://localhost:11434/v1
#   SELFHOSTED_EMBEDDING_DIMENSIONS=768
# EMBEDDING_PROVIDER=openai

# ── Optional: self-hosted (Ollama-compatible) generation model ──────────
# Only needed if you add 'selfhosted' to PROVIDER_CHAIN.
# SELFHOSTED_BASE_URL=http://localhost:11434/v1
# SELFHOSTED_MODEL=llama3.1:8b

# ── Optional: Jira integration module (see JIRA_INTEGRATION.md) ────────
# Only needed if you're pulling defect records in from Jira instead of
# seeding them manually.
# ATLASSIAN_OAUTH_CLIENT_ID=
# ATLASSIAN_OAUTH_CLIENT_SECRET=
# ATLASSIAN_OAUTH_CALLBACK_URL=http://localhost:3000/api/jira/callback
# TOKEN_ENCRYPTION_KEY=
# FRONTEND_URL=http://localhost:5500
