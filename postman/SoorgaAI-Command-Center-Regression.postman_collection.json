                "pm.test('success is false', () => pm.expect(json.success).to.be.false);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/users/login", "host": ["{{baseUrl}}"], "path": ["api","users","login"] },
            "body": { "mode": "raw", "raw": "{\n  \"email\": \"qa-regression@soorgaai.test\"\n}" }
          }
        },

        {
          "name": "API-REG-003 — Edge: Wrong password → 401",
          "event": [{
            "listen": "test",
