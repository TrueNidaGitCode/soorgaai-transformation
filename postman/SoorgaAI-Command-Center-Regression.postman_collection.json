            "body": { "mode": "raw", "raw": "{\n  \"email\": 12345,\n  \"password\": true\n}" }
          }
        }

      ]
    },

    {
      "name": "4 — API-REG-004: Stage Data Consistency Check",
      "description": "Verifies that the 5 stage names returned by the backend scoring engine exactly match the stage names declared in frontend/data/maturityStages.js.\nSpec: API-REG-004\n\nThis test runs a full dynamic assessment flow and checks the maturityStage field in the score response.\nExpected stage names: AI Scramble | AI Pivot | AI Alignment | AI Transform | AI-Fueled Enterprise",
      "item": [

        {
          "name": "API-REG-004a — Start Dynamic Session (Setup for stage test)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                "const json = pm.response.json();",
                "pm.collectionVariables.set('regSessionId', json.sessionId);",
                "console.log('✅ regSessionId saved:', json.sessionId);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/assessment/dynamic/sessions", "host": ["{{baseUrl}}"], "path": ["api","assessment","dynamic","sessions"] },
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Stage Consistency QA\",\n  \"role\": \"CTO / CIO\",\n  \"companyName\": \"Regression Test Co\"\n}" }
          }
        },

        {
          "name": "API-REG-004b — Discover Domain",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('domain is a string', () => pm.expect(json.domain).to.be.a('string').and.not.empty);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/assessment/dynamic/sessions/{{regSessionId}}/discover",
              "host": ["{{baseUrl}}"], "path": ["api","assessment","dynamic","sessions","{{regSessionId}}","discover"]
            },
            "body": { "mode": "raw", "raw": "{\n  \"companyName\": \"Regression Test Co\"\n}" }
          }
        },

        {
          "name": "API-REG-004c — Generate Questions",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200', () => pm.response.to.have.status(200));",
                "const json = pm.response.json();",
                "pm.test('Questions array is present', () => pm.expect(json.questions).to.be.an('array').with.lengthOf.at.least(1));",
                "",
                "// Persist all question IDs for bulk answer submission",
                "const ids = json.questions.map(q => q.questionId);",
                "pm.collectionVariables.set('regQuestionIds', JSON.stringify(ids));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/assessment/dynamic/sessions/{{regSessionId}}/questions",
              "host": ["{{baseUrl}}"], "path": ["api","assessment","dynamic","sessions","{{regSessionId}}","questions"]
            },
            "body": { "mode": "raw", "raw": "{}" }
          }
        },

        {
          "name": "API-REG-004d — Submit All Answers (Batch via pre-request script)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Submit all answers programmatically before the score call",
                  "const sessionId = pm.collectionVariables.get('regSessionId');",
                  "const ids = JSON.parse(pm.collectionVariables.get('regQuestionIds') || '[]');",
                  "const baseUrl = pm.collectionVariables.get('baseUrl');",
                  "",
                  "const submitAnswer = (questionId) => new Promise((resolve) => {",
                  "  pm.sendRequest({",
                  "    url: `${baseUrl}/api/assessment/dynamic/sessions/${sessionId}/answers`,",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ questionId, value: 3 }) }",
                  "  }, (err, res) => resolve(res));",
                  "});",
                  "",
                  "// Submit first answer synchronously (Postman pre-request is sync-ish)",
                  "if (ids.length > 0) {",
                  "  ids.forEach(id => {",
                  "    pm.sendRequest({",
                  "      url: `${baseUrl}/api/assessment/dynamic/sessions/${sessionId}/answers`,",
                  "      method: 'POST',",
                  "      header: { 'Content-Type': 'application/json' },",
                  "      body: { mode: 'raw', raw: JSON.stringify({ questionId: id, value: 3 }) }",
                  "    }, () => {});",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// Small delay accommodated by Postman's sequential execution",
                  "pm.test('Score endpoint returns 200', () => pm.response.to.have.status(200));",
                  "",
                  "const json = pm.response.json();",
                  "pm.test('overallScore is a number 0–100', () => {",
                  "  pm.expect(json.overallScore).to.be.a('number');",
                  "  pm.expect(json.overallScore).to.be.at.least(0).and.at.most(100);",
                  "});",
                  "",
                  "// ── STAGE CONSISTENCY ASSERTION ────────────────────────────────────────",
                  "// These MUST match frontend/data/maturityStages.js MATURITY_STAGES[i].name",
                  "const EXPECTED_STAGE_NAMES = [",
                  "  'AI Scramble',",
                  "  'AI Pivot',",
                  "  'AI Alignment',",
                  "  'AI Transform',",
                  "  'AI-Fueled Enterprise'",
                  "];",
                  "",
                  "pm.test('maturityStage is one of the 5 canonical stage names', () => {",
                  "  pm.expect(json.maturityStage).to.be.a('string').and.not.empty;",
                  "  pm.expect(EXPECTED_STAGE_NAMES).to.include(json.maturityStage);",
                  "});",
                  "",
                  "pm.test('maturityStageDetails.stage matches maturityStage', () => {",
                  "  if (json.maturityStageDetails) {",
                  "    pm.expect(json.maturityStageDetails.stage).to.equal(json.maturityStage);",
                  "  }",
                  "});",
                  "",
                  "console.log(`✅ Stage returned: \"${json.maturityStage}\" (score: ${json.overallScore})`);",
                  "console.log('Stage names verified against frontend/data/maturityStages.js');"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/api/assessment/dynamic/sessions/{{regSessionId}}/score",
              "host": ["{{baseUrl}}"], "path": ["api","assessment","dynamic","sessions","{{regSessionId}}","score"]
            },
            "body": { "mode": "raw", "raw": "{}" }
          }
        }

      ]
    }

  ]
}
