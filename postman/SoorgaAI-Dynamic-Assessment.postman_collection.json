        {
          "name": "TC-API-016b — Submit All Remaining Answers (Setup for Scoring)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Sequentially submit value=3 for every questionId in the session.",
                  "// We read allQuestionIds saved during TC-API-009.",
                  "const allIds = JSON.parse(pm.collectionVariables.get('allQuestionIds') || '[]');",
                  "const sessionId = pm.collectionVariables.get('sessionId');",
                  "const baseUrl   = pm.collectionVariables.get('baseUrl');",
                  "",
                  "// Use pm.sendRequest for each remaining question",
                  "const submitAll = (ids, cb) => {",
                  "  if (ids.length === 0) return cb();",
                  "  const [head, ...tail] = ids;",
                  "  pm.sendRequest({",
                  "    url: `${baseUrl}/api/assessment/dynamic/sessions/${sessionId}/answers`,",
                  "    method: 'POST',",
                  "    header: { 'Content-Type': 'application/json' },",
                  "    body: { mode: 'raw', raw: JSON.stringify({ questionId: head, value: 3 }) }",
                  "  }, () => submitAll(tail, cb));",
                  "};",
                  "",
                  "submitAll(allIds, () => console.log('✅ All answers submitted'));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// This request itself submits the first question again (idempotent overwrite).",
                  "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test('complete flag is true (all answered)', () => pm.expect(json.complete).to.be.true);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/assessment/dynamic/sessions/{{sessionId}}/answers", "host": ["{{baseUrl}}"], "path": ["api","assessment","dynamic","sessions","{{sessionId}}","answers"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"questionId\": \"{{questionId}}\",\n  \"value\": 3\n}"
            }
          }
        }

