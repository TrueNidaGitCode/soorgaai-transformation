        {
          "name": "TC-API-017 — Compute Score (Happy Path — All Answers)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                "",
                "const json = pm.response.json();",
                "pm.test('success is true', () => pm.expect(json.success).to.be.true);",
                "pm.test('sessionId is present', () => pm.expect(json.sessionId).to.be.a('string'));",
                "pm.test('overallScore is 0–100', () => {",
                "  pm.expect(json.overallScore).to.be.a('number');",
                "  pm.expect(json.overallScore).to.be.at.least(0).and.at.most(100);",
                "});",
                "pm.test('maturityStage is a known stage name', () => {",
                "  const validStages = ['AI Scramble','AI Pivot','AI Alignment','AI Transform','AI-Fueled Enterprise'];",
                "  pm.expect(validStages).to.include(json.maturityStage);",
                "});",
                "pm.test('maturityStageDetails has description', () => {",
                "  pm.expect(json.maturityStageDetails).to.have.property('description');",
                "});",
                "pm.test('focusAreaScores is an array', () => {",
                "  pm.expect(json.focusAreaScores).to.be.an('array');",
                "  pm.expect(json.focusAreaScores.length).to.be.at.least(1);",
                "});",
                "pm.test('each focusAreaScore has score 0–100', () => {",
                "  json.focusAreaScores.forEach(fa => {",
                "    pm.expect(fa.score).to.be.a('number');",
                "    pm.expect(fa.score).to.be.at.least(0).and.at.most(100);",
                "  });",
                "});",
                "pm.test('companyName is present', () => pm.expect(json.companyName).to.be.a('string'));",
                "pm.test('domain is present', () => pm.expect(json.domain).to.be.a('string'));"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/assessment/dynamic/sessions/{{sessionId}}/score", "host": ["{{baseUrl}}"], "path": ["api","assessment","dynamic","sessions","{{sessionId}}","score"] },
            "body": { "mode": "raw", "raw": "{}" }
          }
        },

        {
          "name": "TC-API-018 — Compute Score (No Answers → 400)",
          "event": [{
            "listen": "prerequest",
            "script": {
              "exec": [
                "// Create a fresh session (no answers) for this negative test",
                "const baseUrl = pm.collectionVariables.get('baseUrl');",
                "pm.sendRequest({",
