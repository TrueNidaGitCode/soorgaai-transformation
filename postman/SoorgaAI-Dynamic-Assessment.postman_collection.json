        {
          "name": "TC-API-001 — Start Session (Happy Path)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
                "",
                "const json = pm.response.json();",
                "pm.test('success flag is true', () => pm.expect(json.success).to.be.true);",
                "pm.test('sessionId is present and non-empty', () => {",
                "  pm.expect(json.sessionId).to.be.a('string').and.not.empty;",
                "});",
                "pm.test('message is present', () => pm.expect(json.message).to.be.a('string'));",
                "",
                "// Persist sessionId for all downstream requests",
                "pm.collectionVariables.set('sessionId', json.sessionId);",
                "console.log('✅ sessionId saved:', json.sessionId);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/assessment/dynamic/sessions", "host": ["{{baseUrl}}"], "path": ["api","assessment","dynamic","sessions"] },
