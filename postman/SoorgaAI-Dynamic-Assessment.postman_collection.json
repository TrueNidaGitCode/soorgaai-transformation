    {
      "name": "3 — Question Generation",
      "item": [

        {
          "name": "TC-API-009 — Generate Questions (Happy Path)",
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
                "",
                "const json = pm.response.json();",
                "pm.test('success is true', () => pm.expect(json.success).to.be.true);",
                "pm.test('questions array is present', () => pm.expect(json.questions).to.be.an('array'));",
                "pm.test('20 or fewer questions returned', () => pm.expect(json.questions.length).to.be.at.most(20));",
                "pm.test('at least 5 questions returned', () => pm.expect(json.questions.length).to.be.at.least(5));",
                "",
                "const q = json.questions[0];",
                "pm.test('first question has questionId', () => pm.expect(q.questionId).to.be.a('string'));",
                "pm.test('first question has text', () => pm.expect(q.text).to.be.a('string').and.not.empty);",
                "pm.test('first question has focusAreaId', () => pm.expect(q.focusAreaId).to.be.a('string'));",
                "pm.test('first question has 5 options', () => pm.expect(q.options).to.have.lengthOf(5));",
                "",
                "const validFocusAreas = ['ai-strategy','leadership','ai-use-cases','data-readiness','technology','skills-workforce','governance'];",
                "pm.test('all questions have valid focusAreaId', () => {",
                "  json.questions.forEach(question => {",
                "    pm.expect(validFocusAreas).to.include(question.focusAreaId);",
                "  });",
                "});",
                "",
                "pm.test('option values are numbers 1–5', () => {",
                "  json.questions.forEach(question => {",
                "    question.options.forEach(opt => {",
                "      pm.expect(opt.value).to.be.a('number');",
                "      pm.expect(opt.value).to.be.at.least(1).and.at.most(5);",
                "    });",
                "  });",
                "});",
                "",
                "// Save first questionId for answer submission tests",
                "pm.collectionVariables.set('questionId', q.questionId);",
                "// Save all questionIds as JSON string for batch submission",
                "const allQIds = json.questions.map(qu => qu.questionId);",
                "pm.collectionVariables.set('allQuestionIds', JSON.stringify(allQIds));",
                "console.log('✅ questionId saved:', q.questionId);"
              ],
              "type": "text/javascript"
            }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/assessment/dynamic/sessions/{{sessionId}}/questions", "host": ["{{baseUrl}}"], "path": ["api","assessment","dynamic","sessions","{{sessionId}}","questions"] },
            "body": { "mode": "raw", "raw": "{}" }
          }
        },

